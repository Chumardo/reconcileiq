{
  "schema_version": 1,
  "description": "All data is synthetic. Each untouched baseline index produces one matched pair.",
  "seed": 1729,
  "baseline_pairs": 10000,
  "baseline_row_id_formats": {
    "a": "A-{index:05d}",
    "b": "B-{index:05d}"
  },
  "scenarios": [
    {
      "name": "Missing in the ledger",
      "mutations": [
        {
          "source": "a",
          "operation": "delete",
          "row_id": "A-00001",
          "before": {
            "row_id": "A-00001",
            "merchant": "SYNTH-001",
            "transaction": "000001",
            "amount": "-264.22",
            "status": "PENDING",
            "currency": "GBP"
          },
          "after": null
        }
      ],
      "expected_records": [
        {
          "row_id_a": null,
          "row_id_b": "B-00001",
          "classification": "missing_in_source_a",
          "flags": [
            "missing_in_source_a"
          ]
        }
      ]
    },
    {
      "name": "Missing in the settlement export",
      "mutations": [
        {
          "source": "b",
          "operation": "delete",
          "row_id": "B-00002",
          "before": {
            "row_id": "B-00002",
            "merchant": "SYNTH-002",
            "transaction": "000001",
            "amount": "1899.76",
            "status": "PAID",
            "currency": "GBP"
          },
          "after": null
        }
      ],
      "expected_records": [
        {
          "row_id_a": "A-00002",
          "row_id_b": null,
          "classification": "missing_in_source_b",
          "flags": [
            "missing_in_source_b"
          ]
        }
      ]
    },
    {
      "name": "Ledger amount differs by one cent",
      "mutations": [
        {
          "source": "a",
          "operation": "update",
          "row_id": "A-00003",
          "before": {
            "row_id": "A-00003",
            "merchant": "SYNTH-003",
            "transaction": "000001",
            "amount": "-195.00",
            "status": "PAID",
            "currency": "EUR"
          },
          "after": {
            "row_id": "A-00003",
            "merchant": "SYNTH-003",
            "transaction": "000001",
            "amount": "-194.99",
            "status": "PAID",
            "currency": "EUR"
          }
        }
      ],
      "expected_records": [
        {
          "row_id_a": "A-00003",
          "row_id_b": "B-00003",
          "classification": "amount_mismatch",
          "flags": [
            "amount_mismatch"
          ]
        }
      ]
    },
    {
      "name": "Settlement status differs",
      "mutations": [
        {
          "source": "b",
          "operation": "update",
          "row_id": "B-00004",
          "before": {
            "row_id": "B-00004",
            "merchant": "SYNTH-004",
            "transaction": "000001",
            "amount": "2225.79",
            "status": "PENDING",
            "currency": "EUR"
          },
          "after": {
            "row_id": "B-00004",
            "merchant": "SYNTH-004",
            "transaction": "000001",
            "amount": "2225.79",
            "status": "REVERSED",
            "currency": "EUR"
          }
        }
      ],
      "expected_records": [
        {
          "row_id_a": "A-00004",
          "row_id_b": "B-00004",
          "classification": "status_mismatch",
          "flags": [
            "status_mismatch"
          ]
        }
      ]
    },
